      }
    },
    "Layer effects were discarded, so the appearance may differ.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层效果已被丢弃，因此外观可能不同。"
          }
        }
      }
    },
    "Vector shape was rasterized to pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "矢量形状已栅格化为像素。"
          }
        }
      }
    },
    "This Photoshop layer type isn’t supported and was imported as pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此 Photoshop 图层类型，已作为像素导入。"
          }
        }
      }
    },
    "Folder blend mode “%@” isn’t supported. The folder will be pass-through.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持文件夹混合模式“%@”。该文件夹将使用穿透。"
          }
        }
      }
    },
    "Blend mode “%@” isn’t supported and will be applied as Normal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持混合模式“%@”，将按“正常”应用。"
          }
        }
      }
    },
    "This adjustment type isn’t supported and was skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此调整类型，已跳过。"
          }
        }
      }
    },
    "Adjustment parameters may not match Photoshop exactly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整参数可能与 Photoshop 不完全一致。"
          }
        }
      }
    },
    "The layer mask couldn’t be converted to 8-bit grayscale and was skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层蒙版无法转换为 8 位灰度，已跳过。"
          }
        }
      }
    },
    "This clipping mask’s base isn’t supported, so clipping was skipped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此剪贴蒙版的基底，因此已跳过剪贴。"
          }
        }
      }
    },
    "The font “%@” isn’t installed, so the text was drawn with the system font.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装字体“%@”，因此文本使用系统字体绘制。"
          }
        }
      }
    },
    "The Photoshop file could not be read. It may be damaged or incomplete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该 Photoshop 文件。它可能已损坏或不完整。"
          }
        }
      }
    },
    "This Photoshop file uses a format version Compositor can’t read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Photoshop 文件使用的格式版本 Compositor 无法读取。"
          }
        }
      }
    },
    "Only 8-bit RGB Photoshop files can be imported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能导入 8 位 RGB Photoshop 文件。"
          }
        }
      }
    },
    "This Photoshop file uses a layer compression method that isn’t supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Photoshop 文件使用了不受支持的图层压缩方法。"
          }
        }
      }
    },
    "The Photoshop stroke isn’t supported on shape layers and was omitted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状图层不支持此 Photoshop 描边，已省略。"
          }
        }
      }
    },
    "This is not a valid Compositor project, or its metadata is damaged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是有效的 Compositor 项目，或其元数据已损坏。"
          }
        }
      }
    },
    "This project uses format version %@. This app supports versions %@–%@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目使用格式版本 %@。本应用支持版本 %@–%@。"
          }
        }
      }
    },
    "An image inside the project is missing or damaged. The current document has not been replaced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目中的某个图像缺失或已损坏。当前文档未被替换。"
          }
        }
      }
    },
    "This project exceeds the supported canvas, layer, file-size, or %@-megapixel document limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目超出了支持的画布、图层、文件大小或 %@ 百万像素文档上限。"
          }
        }
      }
    },
    "An image could not be saved. The previous project has not been replaced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储某个图像。之前的项目未被替换。"
          }
        }
      }
    },
    "Save Project As": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目存储为"
          }
        }
      }
    },
    "Save Project": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储项目"
          }
        }
      }
    },
    "New %@ Adjustment": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建%@调整图层"
          }
        }
      }
    },
    "Edit %@ Adjustment": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑%@调整"
          }
        }
      }
    },
    "Cancel %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消 %@"
          }
        }
      }
    },
    "Edit %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑 %@"
          }
        }
      }
    },
    "Add %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 %@"
          }
        }
      }
    },
    "Copy %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝 %@"
          }
        }
      }
    },
    "Remove %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移去 %@"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖移以提亮或压暗这些色调。沿底部拖移分隔线，可更改每个区域覆盖的色调。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移点。点击以添加。双击点以删除。"
          }
        }
      }
    },
    "Lifts or lowers the brightest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗最亮的色调。"
          }
        }
      }
    },
    "Lifts or lowers the light tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗较亮的色调。"
          }
        }
      }
    },
    "Lifts or lowers the dark tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗较暗的色调。"
          }
        }
      }
    },
    "Lifts or lowers the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗最暗的色调。"
          }
        }
      }
    },
    "How much the curve also changes color strength. Zero matches Photoshop; lower keeps it to brightness, higher adds more color.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线同时改变颜色强度的程度。零与 Photoshop 一致；更低时只影响亮度，更高时增加更多颜色。"
          }
        }
      }
    },
    "Drag on the picture to move the curve for the tone under the pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面上拖移，以移动指针下色调对应的曲线。"
          }
        }
      }
    },
    "Shifts the selected color family around the wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿色轮移动所选颜色系列。"
          }
        }
      }
    },
    "Makes the selected color family stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所选颜色系列更浓或更淡。"
          }
        }
      }
    },
    "Makes the selected color family lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所选颜色系列更亮或更暗。"
          }
        }
      }
    },
    "Hue Shift": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相偏移"
          }
        }
      }
    },
    "Shifts the picked color around the color wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿色轮移动所取颜色。"
          }
        }
      }
    },
    "Saturation Shift": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "饱和度偏移"
          }
        }
      }
    },
    "Makes the picked color stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所取颜色更浓或更淡。"
          }
        }
      }
    },
    "Luminance Shift": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明亮度偏移"
          }
        }
      }
    },
    "Makes the picked color lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所取颜色更亮或更暗。"
          }
        }
      }
    },
    "Hue Range": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相范围"
          }
        }
      }
    },
    "How far in hue the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在色相上延伸的范围。"
          }
        }
      }
    },
    "Saturation Range": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "饱和度范围"
          }
        }
      }
    },
    "How far in saturation the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在饱和度上延伸的范围。"
          }
        }
      }
    },
    "Luminance Range": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明亮度范围"
          }
        }
      }
    },
    "How far in brightness the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在亮度上延伸的范围。"
          }
        }
      }
    },
    "Controls how much the three tonal wheels overlap.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制三个色调轮的重叠程度。"
          }
        }
      }
    },
    "Shifts the wheels toward shadows or highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将色轮偏向阴影或高光。"
          }
        }
      }
    },
    "Brightness added by this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此色轮增加的亮度。"
          }
        }
      }
    },
    "Tones from black on the left to white on the right: blacks, shadows, midtones, highlights, whites. Control-click to show the vectorscope.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左到右由黑到白：黑色、阴影、中间调、高光、白色。按住 Control 点击以显示矢量图。"
          }
        }
      }
    },
    "Hue around the wheel, saturation outward from the center. Control-click to show the histogram.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相绕轮分布，饱和度从中心向外。按住 Control 点击以显示直方图。"
          }
        }
      }
    },
    "Show clipped shadows in blue on the preview.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览中用蓝色显示被剪切的阴影。"
          }
        }
      }
    },
    "Show clipped highlights in red on the preview.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览中用红色显示被剪切的高光。"
          }
        }
      }
    },
    "Shadow Clipping Indicator": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阴影剪切指示"
          }
        }
      }
    },
    "Highlight Clipping Indicator": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光剪切指示"
          }
        }
      }
    },
    "RGB histogram": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB 直方图"
          }
        }
      }
    },
    "Brightens or darkens the whole picture, in stops of light. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以曝光级数提亮或压暗整幅画面。按住 Option 查看被剪切的高光。"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增大或减小亮暗色调的差异，主要作用于中间调。"
          }
        }
      }
    },
    "Adjusts the bright parts of the picture. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面的亮部。按住 Option 查看被剪切的高光。"
          }
        }
      }
    },
    "Adjusts the dark parts of the picture. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面的暗部。按住 Option 查看被剪切的阴影。"
          }
        }
      }
    },
    "Sets the brightest point. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定最亮点。按住 Option 查看被剪切的高光。"
          }
        }
      }
    },
    "Sets the darkest point. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定最暗点。按住 Option 查看被剪切的阴影。"
          }
        }
      }
    },
    "Shifts the picture from blue to yellow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使画面从蓝色偏向黄色。"
          }
        }
      }
    },
    "Shifts the picture from green to mauve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使画面从绿色偏向洋红色。"
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对较淡的颜色比对已经很浓的颜色加强得更多，并保护肤色。"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以相同幅度加强或减弱每种颜色。"
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加或柔化细小细节。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿较大形状增加或柔化对比度。"
          }
        }
      }
    },
    "Clears haze when raised, and adds haze when lowered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升高时去除薄雾，降低时增加薄雾。"
          }
        }
      }
    },
    "Spreads a glow from the bright areas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从亮部向外扩散光晕。"
          }
        }
      }
    },
    "Chooses how bright an area must be to glow. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择多亮的区域才会发光。在提高“发光”之前没有效果。"
          }
        }
      }
    },
    "Sets how far the glow reaches. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定光晕延伸的距离。在提高“发光”之前没有效果。"
          }
        }
      }
    },
    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使光晕从冷色偏向暖色。光晕保持红色。在提高“发光”之前没有效果。"
          }
        }
      }
    },
    "Darkens or lightens the edges. The center does not change.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗或提亮边缘。中心不变。"
          }
        }
      }
    },
    "Sets where the vignette begins, from the center outward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定晕影从中心向外的起始位置。"
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使晕影更圆或更方。"
          }
        }
      }
    },
    "Softens the edge of the vignette.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔化晕影边缘。"
          }
        }
      }
    },
    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用暗角晕影时保护亮像素。由“高光优先”使用。"
          }
        }
      }
    },
    "Adds film grain, strongest in the middle tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，在中间调最明显。"
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒更粗或更细。"
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒更平滑或更不均匀。"
          }
        }
      }
    },
    "Controls how strong the sharpening is.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制锐化的强度。"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锐化从每条边缘延伸的距离，以像素为单位。"
          }
        }
      }
    },
    "Emphasizes fine texture over broader edges.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调细微纹理，而不是较宽的边缘。"
          }
        }
      }
    },
    "Limits sharpening to stronger edges. Hold Option to see the mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将锐化限制在较强的边缘。按住 Option 查看蒙版。"
          }
        }
      }
    },
    "Smooths grain and noise in brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑亮度中的颗粒和杂色。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在减少明亮度杂色时保留细微纹理。"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在明亮度平滑后保留局部对比度。"
          }
        }
      }
    },
    "Smooths colored speckles.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑彩色斑点。"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在减少颜色杂色时保留彩色边缘。"
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颜色平滑更柔和或更紧致。"
          }
        }
      }
    },
    "How much of the profile distortion correction is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用多少配置文件的畸变校正。"
          }
        }
      }
    },
    "How much of the profile vignetting correction is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用多少配置文件的晕影校正。"
          }
        }
      }
    },
    "Straightens barrel or pincushion bending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉直桶形或枕形弯曲。"
          }
        }
      }
    },
