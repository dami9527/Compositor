    "Click a pixel that should be neutral.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击一个应当是中性色的像素。"
          }
        }
      }
    },
    "Click a purple or green fringe to set its hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击紫色或绿色色边，设定其色相范围。"
          }
        }
      }
    },
    "Click a shortcut, then press its new key combination. Changes apply when you save.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击一个快捷键，再按下新的组合键。存储后才会生效。"
          }
        }
      }
    },
    "Click the canvas to sample": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画布上点击取样"
          }
        }
      }
    },
    "Click the fringe on the layer. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图层上点击色边。再次点击吸管即可停止。"
          }
        }
      }
    },
    "Click the original layer to set %@. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在原始图层上点击以设置%@。再次点击吸管即可停止。"
          }
        }
      }
    },
    "Click the original layer. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在原始图层上点击。再次点击吸管即可停止。"
          }
        }
      }
    },
    "Click the picture to save a color. Up to eight colors.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面上点击以保存颜色。最多八个。"
          }
        }
      }
    },
    "Click to add a point. Drag to adjust.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击以添加点。拖移以调整。"
          }
        }
      }
    },
    "Click to select; double-click to edit; Option-drag to copy %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
