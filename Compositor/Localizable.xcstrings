    "Bake and Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烘焙并删除"
          }
        }
      }
    },
    "Bake keeps the current masked appearance in the dependent layers’ pixels. Remove Links reveals their pixels. You can undo either choice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“烘焙”把当前蒙版效果写入依赖图层的像素。“移除链接”则露出它们的像素。两种做法都可以还原。"
          }
        }
      }
    },
    "Balance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡"
