        }
      }
    },
    "Brightens or darkens the corners to counter lens falloff.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗四角，以抵消镜头衰减。"
