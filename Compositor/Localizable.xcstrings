    "Another app changed this project. You can revert to the version on disk, losing your unsaved changes, or keep what you have.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个应用改过这个项目。可以还原为磁盘上的版本（未存储的更改会丢失），或保留你现在的内容。"
          }
        }
      }
    },
    "Anti-alias": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
